generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AttachmentEntityType {
  deed
  allocated_land
  delivered_land
  leased_land_out
  leased_land_in
  leased_building_out
  leased_building_in
  site_inspection
  investment_site
  investment_area
  investment_opportunity
  asset
}

enum AttachmentType {
  deed_image
  survey_document
  plan_image
  location_image
  contract_image
  delivery_minutes
  inspection_image
  other
}

enum InvestmentAreaStatus {
  AVAILABLE
  OCCUPIED
  PARTIALLY_OCCUPIED
  RESERVED
  ALLOCATED
  UNAVAILABLE
}

enum InvestmentReadiness {
  NOT_ASSESSED
  UNDER_REVIEW
  READY
  NOT_SUITABLE
}

enum GeometryAccuracy {
  APPROXIMATE
  FIELD_VERIFIED
  SURVEYED
  OFFICIAL
}

enum GeometryApprovalStatus {
  DRAFT
  REVIEWED
  APPROVED
  CHANGE_REQUESTED
}

enum InvestmentOpportunityStatus {
  IDENTIFIED
  UNDER_STUDY
  PENDING_APPROVAL
  APPROVED
  OFFERED
  NEGOTIATION
  INVESTED
  REJECTED
  CANCELLED
}

enum AppUserRole {
  admin
  employee
}

model AppUser {
  id                  String               @id @default(cuid())
  username            String
  email               String               @unique
  passwordHash        String
  role                AppUserRole          @default(employee)
  isActive            Boolean              @default(true)
  activationTokenHash String?              @unique
  activationExpires   DateTime?
  activationSentAt    DateTime?
  activatedAt         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  permissions         UserPermission[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([isActive])
  @@index([activationExpires])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model UserPermission {
  id              String  @id @default(cuid())
  userId          String
  module          String
  canView         Boolean @default(false)
  canAdd          Boolean @default(false)
  canEdit         Boolean @default(false)
  canDelete       Boolean @default(false)
  canPrint        Boolean @default(false)
  canCreateUser   Boolean @default(false)
  canCreateCycle  Boolean @default(false)
  canApproveCycle Boolean @default(false)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
  @@index([module])
}

model Deed {
  id                  String    @id @default(cuid())
  propertyDescription String
  usageType           String
  deedNumber          String    @unique
  deedDate            DateTime?
  deedDateType        String?   @default("gregorian")
  plotNumber          String?
  planNumber          String?
  area                Float     @default(0)
  location            String?
  coordinates         String?
  isPlanned           Boolean   @default(false)
  city                String?
  district            String?
  region              String?
  notes               String?
  createdBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  investmentSites     InvestmentSite[]
  investmentSiteDeeds InvestmentSiteDeed[]
}

model InvestmentSite {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?

  deedId      String?
  deed        Deed?    @relation(fields: [deedId], references: [id], onDelete: SetNull)

  latitude         Decimal?          @db.Decimal(10, 7)
  longitude        Decimal?          @db.Decimal(10, 7)
  geoJson          Json?
  geometryAccuracy GeometryAccuracy  @default(APPROXIMATE)
  geometryApprovalStatus       GeometryApprovalStatus @default(DRAFT)
  geometryReviewedById         String?
  geometryReviewedByName       String?
  geometryReviewedAt           DateTime?
  geometryApprovedById         String?
  geometryApprovedByName       String?
  geometryApprovedAt           DateTime?
  geometryReferenceAttachmentId String?
  geometryWorkflowNote         String?

  region      String?
  city        String?
  district    String?

  isActive    Boolean  @default(true)

  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  areas       InvestmentArea[]
  deedLinks   InvestmentSiteDeed[]

  @@index([deedId])
  @@index([name])
  @@index([isActive])
}

model InvestmentSiteDeed {
  id        String         @id @default(cuid())
  siteId    String
  deedId    String
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now())

  site      InvestmentSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  deed      Deed           @relation(fields: [deedId], references: [id], onDelete: Cascade)

  @@unique([siteId, deedId])
  @@index([deedId])
  @@index([siteId, isPrimary])
}

model InvestmentArea {
  id                  String               @id @default(cuid())
  siteId              String
  site                InvestmentSite       @relation(fields: [siteId], references: [id], onDelete: Restrict)

  areaNumber          Int
  areaCode            String               @unique
  name                String?
  description         String?

  approximateArea     Decimal?             @db.Decimal(18, 2)
  surveyedArea        Decimal?             @db.Decimal(18, 2)

  latitude            Decimal?             @db.Decimal(10, 7)
  longitude           Decimal?             @db.Decimal(10, 7)
  geoJson             Json?

  geometryAccuracy    GeometryAccuracy     @default(APPROXIMATE)
    geometryApprovalStatus       GeometryApprovalStatus @default(DRAFT)
    geometryReviewedById         String?
    geometryReviewedByName       String?
    geometryReviewedAt           DateTime?
    geometryApprovedById         String?
    geometryApprovedByName       String?
    geometryApprovedAt           DateTime?
    geometryReferenceAttachmentId String?
    geometryWorkflowNote         String?

  occupancyStatus     InvestmentAreaStatus @default(AVAILABLE)
  investmentReadiness InvestmentReadiness  @default(NOT_ASSESSED)

  currentUse          String?
  proposedUse         String?
  notes               String?

  isActive            Boolean              @default(true)

  createdBy           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  opportunities        InvestmentOpportunity[]

  @@unique([siteId, areaNumber])
  @@index([siteId])
  @@index([occupancyStatus])
  @@index([investmentReadiness])
  @@index([isActive])
}

model InvestmentOpportunity {
  id                     String                      @id @default(cuid())
  opportunityNumber      String                      @unique
  areaId                 String
  area                   InvestmentArea              @relation(fields: [areaId], references: [id], onDelete: Restrict)

  title                  String
  investmentUse          String?
  projectDescription     String?
  allocatedArea          Decimal?                    @db.Decimal(18, 2)
  durationMonths         Int?
  estimatedValue         Decimal?                    @db.Decimal(18, 2)
  currency               String                      @default("SAR")

  status                 InvestmentOpportunityStatus @default(IDENTIFIED)
  statusChangedAt        DateTime                    @default(now())
  submittedAt            DateTime?
  approvedAt             DateTime?
  offeredAt              DateTime?
  investedAt             DateTime?
  cancelledAt            DateTime?
  approvedById           String?
  approvedByName         String?
  notes                  String?

  isActive               Boolean                     @default(true)
  createdById            String?
  createdByName          String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  events                 InvestmentOpportunityEvent[]

  @@index([areaId])
  @@index([status])
  @@index([isActive])
  @@index([createdAt])
}

model InvestmentOpportunityEvent {
  id               String                      @id @default(cuid())
  opportunityId    String
  opportunity      InvestmentOpportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  fromStatus       InvestmentOpportunityStatus?
  toStatus         InvestmentOpportunityStatus
  action           String
  note             String?
  changedById      String?
  changedByName    String?
  createdAt        DateTime                    @default(now())

  @@index([opportunityId])
  @@index([createdAt])
}

model AllocatedLand {
  id                  String   @id @default(cuid())
  propertyDescription String
  plotNumber          String?
  planNumber          String?
  area                Float    @default(0)
  usageType           String?
  region              String?
  city                String?
  district            String?
  coordinates         String?
  googleEarthLink     String?
  notes               String?
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DeliveredLand {
  id                    String    @id @default(cuid())
  receiptNumber         String?
  receiptDate           DateTime?
  receiptDateType       String?
  deliveryDate          DateTime?
  deliveryDateType      String?
  deliveringEntity      String?
  recipientEntity       String
  landName              String?
  description           String?
  propertyDescription   String
  region                String?
  city                  String?
  district              String?
  plotNumber            String?
  planNumber            String?
  area                  Float     @default(0)
  usageType             String?
  status                String?
  hasRelatedDeed        Boolean   @default(false)
  relatedDeedNumber     String?
  location              String?
  coordinates           String?
  deliveryMinutesNumber String?
  notes                 String?
  createdBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([receiptNumber])
  @@index([city])
  @@index([status])
}

model LeasedLandOut {
  id                        String    @id @default(cuid())
  tenant                    Json
  contractNumber            String
  contractStartDate         DateTime?
  contractStartDateType     String?   @default("gregorian")
  contractDuration          String?
  plotNumber                String?
  planNumber                String?
  area                      Float     @default(0)
  location                  String?
  coordinates               String?
  rentAmount                Float?
  notes                     String?
  createdBy                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  contractStartDateOriginal String?
  contractEndDate           DateTime?
  contractEndDateOriginal   String?
  contractEndDateType       String?   @default("gregorian")
}

model LeasedLandIn {
  id                        String    @id @default(cuid())
  owner                     Json
  contractNumber            String
  contractDuration          String?
  propertyDescription       String
  area                      Float     @default(0)
  location                  String?
  coordinates               String?
  rentAmount                Float?
  notes                     String?
  createdBy                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  contractStartDate         DateTime?
  contractStartDateOriginal String?
  contractStartDateType     String?   @default("gregorian")
  contractEndDate           DateTime?
  contractEndDateOriginal   String?
  contractEndDateType       String?   @default("gregorian")
}

model LeasedBuildingOut {
  id                        String    @id @default(cuid())
  tenant                    Json
  contractNumber            String
  buildingNumber            String
  planNumber                String?
  locationName              String
  area                      Float     @default(0)
  city                      String?
  district                  String?
  coordinates               String?
  rentAmount                Float?
  notes                     String?
  createdBy                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  contractStartDate         DateTime?
  contractStartDateOriginal String?
  contractStartDateType     String?   @default("gregorian")
  contractEndDate           DateTime?
  contractEndDateOriginal   String?
  contractEndDateType       String?   @default("gregorian")
}

model LeasedBuildingIn {
  id                        String    @id @default(cuid())
  owner                     Json
  contractNumber            String
  buildingNumber            String
  locationName              String
  area                      Float     @default(0)
  region                    String?
  city                      String?
  coordinates               String?
  rentAmount                Float?
  notes                     String?
  createdBy                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  contractStartDate         DateTime?
  contractStartDateOriginal String?
  contractStartDateType     String?   @default("gregorian")
  contractEndDate           DateTime?
  contractEndDateOriginal   String?
  contractEndDateType       String?   @default("gregorian")
}

model Asset {
  id                        String    @id @default(cuid())
  assetNumber               String?   @unique
  itemNumber                String?   @unique
  barcode                   String?   @unique
  name                      String
  category                  String
  brand                     String?
  model                     String?
  serialNumber              String?   @unique
  status                    String    @default("available")
  technicalCondition        String?
  department                String?
  building                  String?
  floor                     String?
  room                      String?
  custodian                 String?
  entityName                String?
  entityCode                String?
  assetDescription          String?
  cardNumber                String?
  responsibleDepartment     String?
  region                    String?
  city                      String?
  buildingNumber            String?
  coordinates               String?
  classification1           String?
  classification2           String?
  classification3           String?
  classification4           String?
  classification5           String?
  classification6           String?
  accountingGroup           String?
  accountingGroupCode       String?
  assetCode                 String?
  remainingLife             Float?
  usefulLife                Float?
  purchaseDate              DateTime?
  purchaseDateType          String?   @default("gregorian")
  purchaseValue             Float?
  vatRate                   Float?    @default(15)
  vatAmount                 Float?
  purchaseValueBeforeVat    Float?
  purchaseValueIncludingVat Float?
  serviceDate               DateTime?
  serviceDateType           String?   @default("gregorian")
  acquisitionCost           Float?
  supportingCostDocument    String?
  archiveDocumentNumber     String?
  manufacturer              String?
  lastInventoryDate         DateTime?
  lastInventoryDateType     String?   @default("gregorian")
  unitOfMeasure             String?
  quantity                  Float?    @default(1)
  excelPayload              Json?
  notes                     String?
  stableKey                 String?
  isInCurrentCycle          Boolean   @default(true)
  cycleState                String    @default("current")
  lastApprovedCycleId       String?
  createdBy                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  movements       AssetMovement[]
  lossCases       AssetLossCase[]
  inventoryEvents AssetInventoryEvent[]

  @@index([itemNumber])
  @@index([barcode])
  @@index([category])
  @@index([status])
  @@index([technicalCondition])
  @@index([department])
  @@index([building])
  @@index([stableKey])
  @@index([isInCurrentCycle])
  @@index([lastApprovedCycleId])
  @@index([createdAt])
}

model AssetUpdateCycle {
  id              String    @id @default(cuid())
  cycleNumber     Int       @unique
  name            String
  description     String?
  status          String    @default("draft")
  isCurrent       Boolean   @default(false)
  basedOnCycleId  String?
  sourceFileNames Json?
  importedAt      DateTime?
  importedBy      String?
  reviewedAt      DateTime?
  reviewedBy      String?
  approvedAt      DateTime?
  approvedBy      String?
  archivedAt      DateTime?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  records AssetCycleRecord[]

  @@index([status])
  @@index([isCurrent])
  @@index([cycleNumber])
  @@index([createdAt])
}

model AssetCycleRecord {
  id                String    @id @default(cuid())
  cycleId           String
  assetId           String?
  stableKey         String
  sourceFingerprint String?
  changeType        String    @default("manual")
  reviewStatus      String    @default("auto")
  previousRecordId  String?
  itemNumber        String?
  assetNumber       String?
  barcode           String?
  serialNumber      String?
  cardNumber        String?
  name              String
  category          String
  department        String?
  building          String?
  changedFields     Json?
  payload           Json
  sourceFileName    String?
  sourceFileHash    String?
  sourceSheet       String?
  sourceRow         Int?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  cycle AssetUpdateCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@index([assetId])
  @@index([stableKey])
  @@index([changeType])
  @@index([reviewStatus])
  @@index([itemNumber])
  @@index([barcode])
  @@index([serialNumber])
  @@index([department])
  @@index([createdAt])
}

model AssetMovement {
  id             String   @id @default(cuid())
  assetId        String
  movementType   String   @default("transfer")
  fromDepartment String?
  fromBuilding   String?
  fromFloor      String?
  fromRoom       String?
  toDepartment   String?
  toBuilding     String?
  toFloor        String?
  toRoom         String?
  reason         String?
  notes          String?
  movedBy        String?
  movedAt        DateTime @default(now())
  createdAt      DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([movedAt])
}

model AssetLossCase {
  id              String    @id @default(cuid())
  caseNumber      String    @unique
  assetId         String
  minutesNumber   String?
  minutesDate     DateTime?
  minutesDateType String?   @default("gregorian")
  department      String?
  reason          String?
  assetValue      Float?
  actionTaken     String?
  notes           String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([createdAt])
}

model AssetInventoryEvent {
  id             String   @id @default(cuid())
  assetId        String
  method         String
  scannedBarcode String?
  result         String   @default("matched")
  department     String?
  building       String?
  floor          String?
  room           String?
  notes          String?
  scannedBy      String?
  scannedAt      DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([method])
  @@index([scannedAt])
}

model Attachment {
  id             String               @id @default(cuid())
  entityType     AttachmentEntityType
  entityId       String
  attachmentType AttachmentType       @default(other)
  title          String
  driveUrl       String
  driveFileId    String?
  mimeType       String?
  notes          String?
  createdBy      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([entityType, entityId])
}

model ArchiveDocument {
  id               String   @id @default(cuid())
  title            String
  category         String   @default("عام")
  documentNumber   String?
  documentDate     String?
  documentDateType String   @default("gregorian")
  issuingAuthority String?
  confidentiality  String   @default("internal")
  tags             String?
  description      String?
  fileName         String
  originalName     String?
  mimeType         String?
  fileSize         Float    @default(0)
  driveUrl         String
  driveFileId      String?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([documentNumber])
  @@index([confidentiality])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  username     String?
  userEmail    String?
  userRole     String?
  action       String
  module       String
  entity       String?
  entityId     String?
  entityLabel  String?
  status       String   @default("success")
  description  String?
  details      Json?
  previousData Json?
  newData      Json?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([status])
  @@index([createdAt])
}

model SiteInspection {
  id                  String    @id @default(cuid())
  inspectionNumber    String    @unique
  title               String
  siteType            String
  siteName            String
  visitDate           DateTime
  visitDateType       String?   @default("gregorian")
  visitPurpose        String?
  inspectorName       String?
  accompanyingEntity  String?
  region              String?
  city                String?
  district            String?
  locationDescription String?
  deedNumber          String?
  plotNumber          String?
  planNumber          String?
  latitude            Float?
  longitude           Float?
  locationAccuracy    Float?
  mapUrl              String?
  overallStatus       String    @default("good")
  priority            String    @default("normal")
  observations        String?
  recommendedAction   String?
  referredEntity      String?
  followUpDate        DateTime?
  followUpDateType    String?   @default("gregorian")
  workflowStatus      String    @default("new")
  createdBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items SiteInspectionItem[]

  @@index([visitDate])
  @@index([siteType])
  @@index([city])
  @@index([overallStatus])
  @@index([workflowStatus])
}

model SiteInspectionItem {
  id           String   @id @default(cuid())
  inspectionId String
  category     String
  status       String   @default("good")
  note         String?
  priority     String   @default("normal")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inspection SiteInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([category])
  @@index([status])
}

model ContractFollowUp {
  id               String    @id @default(cuid())
  contractKey      String    @unique
  status           String    @default("not_started")
  assignedTo       String?
  action           String?
  notes            String?
  nextFollowUpDate DateTime?
  updatedBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([nextFollowUpDate])
  @@index([updatedAt])
}

model AssetExcelTemplate {
  id          String   @id @default(cuid())
  templateKey String   @unique
  title       String
  fileName    String
  driveFileId String   @unique
  driveUrl    String
  mimeType    String?
  fileSize    Float?
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([templateKey])
  @@index([updatedAt])
}

// ============================================================
// University Mosques & Prayer Rooms Care Unit
// ============================================================
model MosqueBuilding {
  id                  String   @id @default(cuid())
  buildingNumber      String   @unique
  name                String?
  campusLocation      String?
  city                String?
  district            String?
  latitude            Float?
  longitude           Float?
  expectedUsers       Int?
  coverageStatus      String   @default("unassessed")
  creationFeasibility String   @default("under_study")
  unavailableReason   String?
  approvedAlternative String?
  notes               String?
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sites MosqueSite[]

  @@index([coverageStatus])
  @@index([creationFeasibility])
}

model MosqueSite {
  id               String   @id @default(cuid())
  publicToken      String   @unique @default(uuid())
  name             String
  siteType         String   @default("mosque")
  prayerRoomGender String?
  spatialRelation  String   @default("independent")
  buildingId       String?
  floor            String?
  roomNumber       String?
  city             String?
  district         String?
  campusLocation   String?
  area             Float?
  capacity         Int?
  quranTargetCount     Int?
  hasWomenPrayerArea   Boolean  @default(false)
  womenPrayerArea      Json?
  latitude             Float?
  longitude        Float?
  mapUrl           String?
  status           String   @default("active")
  imamName         String?
  muezzinName      String?
  khateebName      String?
  coordinatorName  String?
  supervisorName   String?
  contactPhone     String?
  notes            String?
  images           Json?
  supervisorUserId String?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  personnel            MosquePersonnel[]
  requests             MosqueRequest[]
  tickets              MosqueTicket[]
  leaves               MosqueLeave[]
  assignments          MosqueUserAssignment[]
  quranInventories     MosqueQuranInventory[]
  quranStockMovements  MosqueQuranStockMovement[]
  quranRackInventories MosqueQuranRackInventory[]
  quranRackMovements   MosqueQuranRackMovement[]
  fieldVisits          MosqueFieldVisit[]
  completionTasks      MosqueCompletionTask[]
  building             MosqueBuilding?            @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  @@index([siteType])
  @@index([city])
  @@index([district])
  @@index([status])
  @@index([supervisorUserId])
  @@index([buildingId])
}

model MosqueFieldTour {
  id            String   @id @default(cuid())
  tourNumber    String   @unique
  title         String
  scheduledDate DateTime
  scope         String?
  teamMembers   Json?
  status        String   @default("scheduled")
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  visits MosqueFieldVisit[]

  @@index([scheduledDate])
  @@index([status])
  @@index([createdAt])
}

model MosqueFieldVisit {
  id                 String    @id @default(cuid())
  visitNumber        String    @unique
  tourId             String?
  siteId             String
  visitType          String    @default("initial")
  visitScope         String    @default("whole_site")
  visitDate          DateTime
  departureAt        DateTime?
  representativeName String?
  teamMembers        Json?
  overallStatus      String    @default("good")
  priority           String    @default("normal")
  workflowStatus     String    @default("planned")
  generalNotes       String?
  recommendations    String?
  attachments        Json?
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tour  MosqueFieldTour?       @relation(fields: [tourId], references: [id], onDelete: SetNull)
  site  MosqueSite             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  items MosqueFieldVisitItem[]

  @@index([tourId])
  @@index([siteId])
  @@index([visitDate])
  @@index([priority])
  @@index([workflowStatus])
}

model MosqueFieldVisitItem {
  id                String    @id @default(cuid())
  visitId           String
  category          String
  title             String
  status            String    @default("not_checked")
  note              String?
  priority          String    @default("normal")
  responsibleEntity String?
  dueDate           DateTime?
  resolutionStatus  String    @default("new")
  resolutionNote    String?
  details           Json?
  beforeImages      Json?
  afterImages       Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  visit MosqueFieldVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([category])
  @@index([priority])
  @@index([resolutionStatus])
  @@index([dueDate])
}

model MosquePersonnel {
  id        String   @id @default(cuid())
  siteId    String
  userId    String?
  name      String
  role      String   @default("collaborator")
  mobile    String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site   MosqueSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  leaves MosqueLeave[]

  @@index([siteId])
  @@index([userId])
  @@index([role])
  @@index([active])
}

model MosqueQuranInventory {
  id            String   @id @default(cuid())
  siteId        String
  largeCount    Int      @default(0)
  mediumCount   Int      @default(0)
  smallCount    Int      @default(0)
  damagedCount  Int      @default(0)
  neededCount   Int      @default(0)
  countedAt     DateTime @default(now())
  countedBy     String?
  countedByName String?
  notes         String?
  createdAt     DateTime @default(now())

  site MosqueSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([countedAt])
  @@index([createdAt])
}

model MosqueQuranWarehouse {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  location       String?
  active         Boolean  @default(true)
  minLargeCount  Int      @default(0)
  minMediumCount Int      @default(0)
  minSmallCount  Int      @default(0)
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movements MosqueQuranStockMovement[]

  @@index([active])
  @@index([name])
}

model MosqueQuranStockMovement {
  id              String   @id @default(cuid())
  movementNumber  String   @unique
  movementType    String
  warehouseId     String
  siteId          String?
  largeCount      Int      @default(0)
  mediumCount     Int      @default(0)
  smallCount      Int      @default(0)
  totalCount      Int      @default(0)
  referenceNumber String?
  movementAt      DateTime @default(now())
  notes           String?
  createdBy       String?
  createdByName   String?
  createdAt       DateTime @default(now())

  warehouse MosqueQuranWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  site      MosqueSite?          @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([warehouseId])
  @@index([siteId])
  @@index([movementType])
  @@index([movementAt])
  @@index([createdAt])
}

model MosqueQuranRackInventory {
  id                 String   @id @default(cuid())
  siteId             String
  itemType           String   @default("shelf_unit")
  presentCount       Int      @default(0)
  targetCount        Int      @default(0)
  capacityCount      Int      @default(0)
  quranCapacityCount Int      @default(0)
  goodCount          Int      @default(0)
  damagedCount       Int      @default(0)
  countedAt          DateTime @default(now())
  countedBy          String?
  countedByName      String?
  notes              String?
  createdAt          DateTime @default(now())

  site MosqueSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([itemType])
  @@index([siteId, itemType])
  @@index([countedAt])
  @@index([createdAt])
}

model MosqueQuranRackMovement {
  id             String   @id @default(cuid())
  movementNumber String   @unique
  movementType   String
  itemType       String   @default("shelf_unit")
  siteId         String?
  quantity       Int
  movementAt     DateTime @default(now())
  notes          String?
  createdBy      String?
  createdByName  String?
  createdAt      DateTime @default(now())

  site MosqueSite? @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([siteId])
  @@index([itemType])
  @@index([movementType])
  @@index([movementAt])
  @@index([createdAt])
}

model MosqueRequest {
  id                    String    @id @default(cuid())
  requestNumber         String    @unique
  siteId                String
  requestType           String
  description           String
  priority              String    @default("medium")
  status                String    @default("new")
  attachments           Json?
  notes                 String?
  submittedBy           String?
  assignedTo            String?
  rejectionReason       String?
  returnReason          String?
  completionEvidenceUrl String?
  closedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  site MosqueSite @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([siteId])
  @@index([requestType])
  @@index([priority])
  @@index([status])
  @@index([submittedBy])
  @@index([assignedTo])
  @@index([createdAt])
}

model MosqueTicket {
  id                 String    @id @default(cuid())
  ticketNumber       String    @unique
  trackingToken      String    @unique @default(uuid())
  siteId             String
  ticketType         String
  description        String
  reporterName       String?
  reporterPhone      String?
  reporterEmail      String?
  attachmentUrl      String?
  status             String    @default("new")
  assignedTo         String?
  convertedRequestId String?
  rejectionReason    String?
  resolutionNote     String?
  notes              String?
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  site MosqueSite @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([siteId])
  @@index([ticketType])
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
}

model MosqueLeave {
  id                String   @id @default(cuid())
  leaveNumber       String   @unique
  siteId            String
  personnelId       String?
  applicantUserId   String?
  requestType       String
  startDate         DateTime
  endDate           DateTime
  reason            String
  replacementName   String
  replacementUserId String?
  attachmentUrl     String?
  status            String   @default("pending")
  notes             String?
  reviewerNote      String?
  rejectionReason   String?
  returnReason      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  site      MosqueSite       @relation(fields: [siteId], references: [id], onDelete: Restrict)
  personnel MosquePersonnel? @relation(fields: [personnelId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([personnelId])
  @@index([applicantUserId])
  @@index([replacementUserId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model MosqueJobApplication {
  id                String    @id @default(cuid())
  applicationNumber String    @unique
  trackingToken     String    @unique @default(uuid())
  fullName          String
  nationalId        String
  phone             String
  email             String
  qualification     String
  experience        String?
  jobType           String
  preferredLocation String?
  cvUrl             String?
  attachments       Json?
  status            String    @default("new")
  internalNotes     String?
  interviewAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([nationalId])
  @@index([email])
  @@index([jobType])
  @@index([status])
  @@index([createdAt])
}

model MosqueUserAssignment {
  id            String   @id @default(cuid())
  userId        String   @unique
  role          String   @default("viewer")
  siteId        String?
  personnelRole String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site MosqueSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([siteId])
}

model MosqueCompletionTask {
  id               String    @id @default(cuid())
  taskNumber       String    @unique
  siteId           String
  missingKey       String
  title            String
  description      String?
  priority         String    @default("medium")
  status           String    @default("open")
  assignedToUserId String?
  assignedToName   String?
  dueDate          DateTime?
  completionNote   String?
  completedAt      DateTime?
  createdBy        String?
  createdByName    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  site MosqueSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([missingKey])
  @@index([priority])
  @@index([status])
  @@index([assignedToUserId])
  @@index([dueDate])
  @@index([createdAt])
}

model MosqueCompletionKpiSnapshot {
  id               String   @id @default(cuid())
  month            String   @unique
  status           String   @default("draft")
  standardCode     String
  kpiScore         Int?
  kpiStatus        String
  payload          Json
  note             String?
  generatedBy      String?
  generatedByName  String?
  generatedAt      DateTime @default(now())
  reviewedBy       String?
  reviewedByName   String?
  reviewedAt       DateTime?
  approvedBy       String?
  approvedByName   String?
  approvedAt       DateTime?
  archivedBy       String?
  archivedByName   String?
  archivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([month])
  @@index([generatedAt])
  @@index([approvedAt])
}

model MosqueImprovementGoal {
  id                    String   @id @default(cuid())
  goalNumber            String   @unique
  year                  Int
  title                 String
  category              String
  metricKey             String
  sourceMonth           String?
  sourceSnapshotId      String?
  assigneeUserId        String?
  assigneeName          String?
  gapKey                String?
  baselineValue         Float
  targetValue           Float
  targetDirection       String
  currentValue          Float?
  currentMonth          String?
  progressPercent       Int      @default(0)
  actionProgressPercent Int      @default(0)
  status                String   @default("draft")
  ownerUserId           String?
  ownerName             String?
  dueDate               DateTime?
  correctiveActions     Json?
  notes                 String?
  measurementNote       String?
  achievedAt            DateTime?
  closureSummary        String?
  closureEvidence       Json?
  evidenceStatus        String   @default("not_submitted")
  evidenceSubmittedBy   String?
  evidenceSubmittedName String?
  evidenceSubmittedAt   DateTime?
  evidenceReviewedBy    String?
  evidenceReviewedName  String?
  evidenceReviewedAt    DateTime?
  evidenceReviewNote    String?
  closedAt              DateTime?
  lastEvaluatedAt       DateTime?
  createdBy             String?
  createdByName         String?
  updatedBy             String?
  updatedByName         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([year])
  @@index([status])
  @@index([category])
  @@index([metricKey])
  @@index([ownerUserId])
  @@index([assigneeUserId])
  @@index([dueDate])
  @@index([currentMonth])
  @@index([evidenceStatus])
  @@index([evidenceSubmittedAt])
}

model MosqueNotification {
  id         String   @id @default(cuid())
  userId     String?
  roleTarget String?
  siteId     String?
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([roleTarget])
  @@index([siteId])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================================
// Accounting Transformation Requirements Follow-up Committee
// ============================================================
model AccountingTransformationCycle {
  id             String    @id @default(cuid())
  cycleNumber    Int       @unique
  name           String
  description    String?
  status         String    @default("draft")
  isCurrent      Boolean   @default(false)
  basedOnCycleId String?
  sourceFileName String?
  importedAt     DateTime?
  importedBy     String?
  reviewedAt     DateTime?
  reviewedBy     String?
  approvedAt     DateTime?
  approvedBy     String?
  archivedAt     DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  records AccountingTransformationRecord[]

  @@index([status])
  @@index([isCurrent])
  @@index([cycleNumber])
  @@index([createdAt])
}

model AccountingTransformationRecord {
  id                  String   @id @default(cuid())
  recordNumber        String   @unique
  cycleId             String?
  stableKey           String?
  changeType          String   @default("manual")
  previousRecordId    String?
  recordType          String
  ownershipMode       String   @default("owned")
  committeeStatus     String   @default("not_reviewed")
  entityName          String?
  entityCode          String?
  mofAssetNumber      String?
  entityAssetNumber   String?
  linkedAsset         String?
  assetDescription    String?
  accountingGroup     String?
  accountingGroupCode String?
  accountingAssetCode String?
  region              String?
  city                String?
  censusProgress      Int      @default(0)
  inventoryProgress   Int      @default(0)
  valuationProgress   Int      @default(0)
  overallProgress     Int      @default(0)
  readinessStatus     String   @default("needs_data")
  sourceFingerprint   String?
  payload             Json
  attachments         Json?
  notes               String?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cycle AccountingTransformationCycle? @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, sourceFingerprint])
  @@index([cycleId])
  @@index([stableKey])
  @@index([changeType])
  @@index([recordType])
  @@index([committeeStatus])
  @@index([readinessStatus])
  @@index([entityName])
  @@index([entityAssetNumber])
  @@index([mofAssetNumber])
  @@index([linkedAsset])
  @@index([accountingAssetCode])
  @@index([city])
  @@index([overallProgress])
  @@index([updatedAt])
}
