generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AttachmentEntityType {
  deed
  allocated_land
  delivered_land
  leased_land_out
  leased_land_in
  leased_building_out
  leased_building_in
  site_inspection
  asset
}

enum AttachmentType {
  deed_image
  plan_image
  location_image
  contract_image
  delivery_minutes
  inspection_image
  other
}

enum AppUserRole {
  admin
  employee
}

model AppUser {
  id                  String               @id @default(cuid())
  username            String
  email               String               @unique
  passwordHash        String
  role                AppUserRole          @default(employee)
  isActive            Boolean              @default(true)
  activationTokenHash String?              @unique
  activationExpires   DateTime?
  activationSentAt    DateTime?
  activatedAt         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  permissions         UserPermission[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([isActive])
  @@index([activationExpires])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model UserPermission {
  id        String  @id @default(cuid())
  userId    String
  module    String
  canView   Boolean @default(false)
  canAdd    Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  canPrint  Boolean @default(false)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
  @@index([module])
}

model Deed {
  id                  String    @id @default(cuid())
  propertyDescription String
  usageType           String
  deedNumber          String    @unique
  deedDate            DateTime?
  deedDateType        String?   @default("gregorian")
  plotNumber          String?
  planNumber          String?
  area                Float     @default(0)
  location            String?
  coordinates         String?
  isPlanned           Boolean   @default(false)
  city                String?
  district            String?
  region              String?
  notes               String?
  createdBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model AllocatedLand {
  id                  String   @id @default(cuid())
  propertyDescription String
  plotNumber          String?
  planNumber          String?
  area                Float    @default(0)
  usageType           String?
  region              String?
  city                String?
  district            String?
  coordinates         String?
  googleEarthLink     String?
  notes               String?
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DeliveredLand {
  id                    String    @id @default(cuid())
  receiptNumber         String?
  receiptDate           DateTime?
  receiptDateType       String?
  deliveryDate          DateTime?
  deliveryDateType      String?
  deliveringEntity      String?
  recipientEntity       String
  landName              String?
  description           String?
  propertyDescription   String
  region                String?
  city                  String?
  district              String?
  plotNumber            String?
  planNumber            String?
  area                  Float     @default(0)
  usageType             String?
  status                String?
  hasRelatedDeed        Boolean   @default(false)
  relatedDeedNumber     String?
  location              String?
  coordinates           String?
  deliveryMinutesNumber String?
  notes                 String?
  createdBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([receiptNumber])
  @@index([city])
  @@index([status])
}

model LeasedLandOut {
  id                String    @id @default(cuid())
  tenant            Json
  contractNumber    String
  contractStartDate DateTime?
  contractStartDateType String? @default("gregorian")
  contractDuration  String?
  plotNumber        String?
  planNumber        String?
  area              Float     @default(0)
  location          String?
  coordinates       String?
  rentAmount        Float?
  notes             String?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  contractStartDateOriginal String?
  contractEndDate           DateTime?
  contractEndDateOriginal   String?
  contractEndDateType       String?   @default("gregorian")
}

model LeasedLandIn {
  id                  String   @id @default(cuid())
  owner               Json
  contractNumber      String
  contractDuration    String?
  propertyDescription String
  area                Float    @default(0)
  location            String?
  coordinates         String?
  rentAmount          Float?
  notes               String?
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  contractStartDate         DateTime?
  contractStartDateOriginal String?
  contractStartDateType     String?   @default("gregorian")
  contractEndDate           DateTime?
  contractEndDateOriginal   String?
  contractEndDateType       String?   @default("gregorian")
}

model LeasedBuildingOut {
  id             String   @id @default(cuid())
  tenant         Json
  contractNumber String
  buildingNumber String
  planNumber     String?
  locationName   String
  area           Float    @default(0)
  city           String?
  district       String?
  coordinates    String?
  rentAmount     Float?
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contractStartDate         DateTime?
  contractStartDateOriginal String?
  contractStartDateType     String?   @default("gregorian")
  contractEndDate           DateTime?
  contractEndDateOriginal   String?
  contractEndDateType       String?   @default("gregorian")
}

model LeasedBuildingIn {
  id             String   @id @default(cuid())
  owner          Json
  contractNumber String
  buildingNumber String
  locationName   String
  area           Float    @default(0)
  region         String?
  city           String?
  coordinates    String?
  rentAmount     Float?
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contractStartDate         DateTime?
  contractStartDateOriginal String?
  contractStartDateType     String?   @default("gregorian")
  contractEndDate           DateTime?
  contractEndDateOriginal   String?
  contractEndDateType       String?   @default("gregorian")
}

model Asset {
  id                    String    @id @default(cuid())
  assetNumber           String?   @unique
  itemNumber            String?   @unique
  barcode               String?   @unique
  name                  String
  category              String
  brand                 String?
  model                 String?
  serialNumber          String?   @unique
  status                String    @default("available")
  technicalCondition    String?
  department            String?
  building              String?
  floor                 String?
  room                  String?
  custodian              String?
  entityName            String?
  entityCode            String?
  assetDescription      String?
  cardNumber            String?
  responsibleDepartment String?
  region                String?
  city                  String?
  buildingNumber        String?
  coordinates           String?
  classification1       String?
  classification2       String?
  classification3       String?
  classification4       String?
  classification5       String?
  classification6       String?
  accountingGroup       String?
  accountingGroupCode   String?
  assetCode             String?
  remainingLife         Float?
  usefulLife            Float?
  purchaseDate          DateTime?
  purchaseDateType      String?   @default("gregorian")
  purchaseValue         Float?
  serviceDate           DateTime?
  serviceDateType       String?   @default("gregorian")
  acquisitionCost       Float?
  supportingCostDocument String?
  archiveDocumentNumber String?
  manufacturer          String?
  lastInventoryDate     DateTime?
  lastInventoryDateType String?   @default("gregorian")
  unitOfMeasure         String?
  quantity              Float?    @default(1)
  excelPayload          Json?
  notes                 String?
  createdBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  movements       AssetMovement[]
  lossCases       AssetLossCase[]
  inventoryEvents AssetInventoryEvent[]

  @@index([itemNumber])
  @@index([barcode])
  @@index([category])
  @@index([status])
  @@index([technicalCondition])
  @@index([department])
  @@index([building])
  @@index([createdAt])
}

model AssetMovement {
  id             String   @id @default(cuid())
  assetId        String
  movementType   String   @default("transfer")
  fromDepartment String?
  fromBuilding   String?
  fromFloor      String?
  fromRoom       String?
  toDepartment   String?
  toBuilding     String?
  toFloor        String?
  toRoom         String?
  reason         String?
  notes          String?
  movedBy        String?
  movedAt        DateTime @default(now())
  createdAt      DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([movedAt])
}

model AssetLossCase {
  id              String   @id @default(cuid())
  caseNumber      String   @unique
  assetId         String
  minutesNumber   String?
  minutesDate     DateTime?
  minutesDateType String?  @default("gregorian")
  department      String?
  reason          String?
  assetValue      Float?
  actionTaken     String?
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([createdAt])
}

model AssetInventoryEvent {
  id             String   @id @default(cuid())
  assetId        String
  method         String
  scannedBarcode String?
  result         String   @default("matched")
  department     String?
  building       String?
  floor          String?
  room           String?
  notes          String?
  scannedBy      String?
  scannedAt      DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([method])
  @@index([scannedAt])
}

model Attachment {
  id             String               @id @default(cuid())
  entityType     AttachmentEntityType
  entityId       String
  attachmentType AttachmentType       @default(other)
  title          String
  driveUrl       String
  driveFileId    String?
  mimeType       String?
  notes          String?
  createdBy      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([entityType, entityId])
}

model ArchiveDocument {
  id               String   @id @default(cuid())
  title            String
  category         String   @default("عام")
  documentNumber   String?
  documentDate     String?
  documentDateType String   @default("gregorian")
  issuingAuthority String?
  confidentiality  String   @default("internal")
  tags             String?
  description      String?
  fileName         String
  originalName     String?
  mimeType         String?
  fileSize         Float    @default(0)
  driveUrl         String
  driveFileId      String?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([documentNumber])
  @@index([confidentiality])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  username     String?
  userEmail    String?
  userRole     String?
  action       String
  module       String
  entity       String?
  entityId     String?
  entityLabel  String?
  status       String   @default("success")
  description  String?
  details      Json?
  previousData Json?
  newData      Json?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([status])
  @@index([createdAt])
}

model SiteInspection {
  id                  String    @id @default(cuid())
  inspectionNumber    String    @unique
  title               String
  siteType            String
  siteName            String
  visitDate           DateTime
  visitDateType       String?   @default("gregorian")
  visitPurpose        String?
  inspectorName       String?
  accompanyingEntity  String?
  region              String?
  city                String?
  district            String?
  locationDescription String?
  deedNumber          String?
  plotNumber          String?
  planNumber          String?
  latitude            Float?
  longitude           Float?
  locationAccuracy    Float?
  mapUrl              String?
  overallStatus       String    @default("good")
  priority            String    @default("normal")
  observations        String?
  recommendedAction   String?
  referredEntity      String?
  followUpDate        DateTime?
  followUpDateType    String?   @default("gregorian")
  workflowStatus      String    @default("new")
  createdBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items SiteInspectionItem[]

  @@index([visitDate])
  @@index([siteType])
  @@index([city])
  @@index([overallStatus])
  @@index([workflowStatus])
}

model SiteInspectionItem {
  id           String   @id @default(cuid())
  inspectionId String
  category     String
  status       String   @default("good")
  note         String?
  priority     String   @default("normal")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inspection SiteInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([category])
  @@index([status])
}


model ContractFollowUp {
  id               String   @id @default(cuid())
  contractKey      String   @unique
  status           String   @default("not_started")
  assignedTo       String?
  action           String?
  notes            String?
  nextFollowUpDate DateTime?
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([nextFollowUpDate])
  @@index([updatedAt])
}


model AssetExcelTemplate {
  id           String   @id @default(cuid())
  templateKey  String   @unique
  title        String
  fileName     String
  driveFileId  String   @unique
  driveUrl     String
  mimeType     String?
  fileSize     Float?
  uploadedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([templateKey])
  @@index([updatedAt])
}
