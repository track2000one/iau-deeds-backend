model AccountingCycleTemplateSnapshot {
  id            String   @id @default(cuid())
  cycleId       String   @unique
  templateId    String
  fileName      String
  versionNumber Int
  driveFileId   String
  attachedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([templateId])
  @@index([versionNumber])
  @@index([attachedAt])
}
