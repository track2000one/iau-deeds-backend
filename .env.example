# Server
PORT=8080
FRONTEND_URL=https://your-frontend.example

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
PASSWORD_RESET_TOKEN_MINUTES=30
ACTIVATION_TOKEN_HOURS=24

# Bootstrap admin (use only for initial provisioning / recovery)
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu.sa
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
BOOTSTRAP_ADMIN_NAME=مسؤول المنصة

# Transactional email (Brevo)
BREVO_API_KEY=replace-with-brevo-api-key
EMAIL_FROM_ADDRESS=no-reply@example.edu.sa
EMAIL_FROM_NAME=منصة إدارة الأصول والأملاك والأوقاف الجامعية

# Google Drive
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=replace-with-google-oauth-refresh-token
GOOGLE_DRIVE_FOLDER_ID=replace-with-private-folder-id

# Optional smart extraction
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_SMART_EXTRACTION_MODEL=gpt-5-mini
